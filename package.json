{
  "name": "@n-seiji/nuthatch",
  "version": "0.1.0",
  "description": "git worktree manager (hop)",
  "homepage": "https://github.com/n-seiji/nuthatch#readme",
  "bugs": {
    "url": "https://github.com/n-seiji/nuthatch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-seiji/nuthatch.git"
  },
  "bin": {
    "hop": "dist/cli.js"
  },
  "files": [
    "dist",
    "shell"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outfile dist/cli.js --target node --format esm",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
